{
  "extends": "./.hutch/devkit/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "bun", "vitest/globals"]
  },
  "include": [
    "src",
    "tests",
    "scripts",
    "electrobun.config.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "hutch.config.ts",
    "eslint.config.mjs",
    "vitest.config.ts"
  ]
}
